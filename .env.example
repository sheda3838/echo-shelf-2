# Supabase Public Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# MongoDB Connection String (Server-side only)
MONGODB_URI=mongodb://127.0.0.1:27017/echo-shelf-2

# Google Gemini / Gemma API Key (Server-side only)
GEMINI_API_KEY=your-gemini-api-key

# YouTube Data API v3 Key (Server-side only)
YOUTUBE_API_KEY=your-youtube-api-key

# GNews API v4 Key (Server-side only)
GNEWS_API_KEY=your-gnews-api-key
